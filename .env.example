# Copy to .env and fill in. For Netlify, set these in Site configuration → Environment variables.
# See docs/ENV-VARIABLES-AND-NETLIFY.md for the full list and where each is used.

# Supabase (frontend: auth, survey, chat storage)
VITE_SUPABASE_URL=https://wxxwxvauseqftyorhkkp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Optional feature flags
# VITE_FEATURE_REFERRALS=false

# Phase 3 RAG (default off until evals pass)
# PHASE3_RAG_ENABLED=false
# PHASE3_EMBEDDING_PROVIDER=hash
# PHASE3_VECTOR_URI=data/index/phase3-index.json

# Optional backend vars (Netlify/Vercel/server — chat uses RunPod, not Groq)
# VLLM_API_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/openai/v1/chat/completions
# LLM_API_KEY=your-runpod-api-key
# VLLM_MODEL=empathy-coach-qwen
# LLM_PROVIDER=runpod   # or openai_compat for a generic OpenAI-compatible VLLM_API_URL
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
