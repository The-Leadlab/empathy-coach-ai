# Copy to .env and fill in. For Netlify, set these in Site configuration → Environment variables.
# See docs/ENV-VARIABLES-AND-NETLIFY.md for the full list and where each is used.

# Supabase (frontend: auth, survey, chat storage)
VITE_SUPABASE_URL=https://wxxwxvauseqftyorhkkp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Optional feature flags
# VITE_FEATURE_REFERRALS=false

# Phase 3 RAG (default off until evals pass; live prompt also gates RAG until Handshake)
# PHASE3_RAG_ENABLED=false
# PHASE3_EMBEDDING_PROVIDER=hash
# PHASE3_VECTOR_URI=data/index/phase3-index.json

# Optional backend vars (Vercel/Netlify/server)
# VLLM_API_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/openai/v1/chat/completions
# LLM_API_KEY=your-runpod-api-key
# VLLM_MODEL=empathy-coach-qwen14
# LLM_PROVIDER=runpod   # Vercel / training default
# LLM_PROVIDER=vault    # Netlify → free local MLX vault (or HF ZeroGPU when account ≥30 days)
# Free path — Mac session only (not 24/7); see docs/MAC-VAULT-SESSION.md:
#   bash scripts/start-mac-vault-session.sh
#   bash scripts/stop-mac-vault-session.sh   # then sleep the Mac
# VAULT_LLM_API_URL=https://YOUR-trycloudflare-host/v1/chat/completions
# VAULT_LLM_API_KEY=contents-of-/tmp/shifted-vault-api-key
# Free path B — HF Space ZeroGPU (code in spaces/vault-zerogpu; needs account age ≥30d or PRO):
# VAULT_LLM_API_URL=https://Alilead-shifted-coach-vault.hf.space/v1/chat/completions
# VAULT_BASE_MODEL=empathy-coach-qwen14
# VAULT_LORA_ADAPTER=   # optional; preferred model id after a short LoRA update
# HF_REPO_ID=Alilead/empathy-coach-qwen14-merged-v2   # private cold storage
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# After vault smoke: keep Groq off the coach path
# COACH_DISABLE_FALLBACK=1
# LLM_FALLBACK=off
# Training-only / cold-start soft path (do not use on Netlify vault coach):
# GROQ_API_KEY=
# RUNPOD_FALLBACK_AFTER_MS=12000
# FALLBACK_LLM_API_KEY=
# FALLBACK_LLM_API_URL=
# FALLBACK_LLM_MODEL=
